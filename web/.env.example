# ======== AI 八卦特刊 MVP 配置 ========

# 唯一需要你填的：百炼平台 API Key（https://bailian.console.aliyun.com/ → API-KEY 管理）
DASHSCOPE_API_KEY=

# ---- 以下均已填好默认值，通常不用改 ----

# 百炼 API 地址（北京地域公有云默认地址）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 文字模型：联网搜新闻 + 八卦化改写（qwen-plus 性价比档；想更强可换 qwen-max）
TEXT_MODEL=qwen-plus

# 随读问答复用同一个百炼文本模型与 DASHSCOPE_API_KEY，无需额外密钥

# 生图模型：万相 2.2 极速版（想更精细可换 wan2.2-t2i-plus，更慢更贵）
IMAGE_MODEL=wan2.2-t2i-flash

# 生图尺寸：16:9 横版（wan2.2 支持 512~1440 区间任意宽高）
IMAGE_SIZE=1280*720

# 每刊抓几条新闻
NEWS_COUNT=8

# 定时出刊时间（服务器本地时间，逗号分隔）。默认早晚各一刊：
#   08:05 收割美国公司夜里放的大招，赶上早高峰通勤吃瓜
#   20:05 收割国内/欧洲白天的新闻，赶上晚间刷手机高峰
UPDATE_TIMES=08:05,20:05

# 隐藏的强制重跑口令：POST /api/admin/rebuild?token=这个值
ADMIN_TOKEN=melon-admin
